# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_NAME="HomeCreww"
# Local: http://localhost:3000
# Production: set to your public site URL (custom domain or production *.vercel.app).
# Do NOT leave as localhost on Vercel — Stripe Connect return will hit the wrong host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
# Optional: Vercel → Deployment Protection → Protection Bypass for Automation.
# Lets Stripe Connect / Checkout return URLs skip the Vercel login wall.
# VERCEL_AUTOMATION_BYPASS_SECRET=""

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://construction_user:construction_pass@127.0.0.1:5432/construction_db?schema=public"

# =============================================================================
# AUTHENTICATION (NextAuth / Auth.js)
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# =============================================================================
# EMAIL (SMTP / Resend / SendGrid)
# =============================================================================
EMAIL_FROM="noreply@construction.com"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# =============================================================================
# FILE STORAGE (S3 / Cloudinary / Uploadthing)
# =============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================================
# STRIPE (Connect + marketplace payments)
# =============================================================================
STRIPE_SECRET_KEY="sk_test_..."
# Prefer STRIPE_PUBLISHABLE_KEY on Vercel (Sensitive OK). NEXT_PUBLIC_ still works as fallback.
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_..."
# Local webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook

# =============================================================================
# CRON (Vercel Cron → /api/cron/marketplace hourly)
# =============================================================================
CRON_SECRET=""

# =============================================================================
# ANALYTICS
# =============================================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
