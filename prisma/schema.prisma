// Construction Management System — Prisma Schema (MongoDB)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  previewFeatures = []
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  SITE_ENGINEER
  FOREMAN
  ACCOUNTANT
  CLIENT
  CONTRACTOR
  VIEWER
}

enum ProjectStatus {
  DRAFT
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum ContractorType {
  GENERAL
  ELECTRICAL
  PLUMBING
  CIVIL
  MECHANICAL
  INTERIOR
  LANDSCAPING
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
}

enum DocumentType {
  CONTRACT
  BLUEPRINT
  PERMIT
  REPORT
  INVOICE
  PHOTO
  VIDEO
  OTHER
}

enum MaterialUnit {
  KG
  TON
  LITRE
  CUBIC_METER
  SQUARE_METER
  PIECE
  BAG
  BUNDLE
  ROLL
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  avatar        String?
  password      String?
  role          UserRole  @default(CLIENT)
  staffRoleId   String?   @db.ObjectId
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staffRole          StaffRole?       @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  managedProjects    Project[]        @relation("ProjectManager")
  assignedTasks      Task[]           @relation("TaskAssignee")
  createdTasks       Task[]           @relation("TaskCreator")
  siteReports        SiteReport[]
  uploadedDocuments  Document[]
  issues             Issue[]          @relation("IssueReporter")
  issueAssignees     Issue[]          @relation("IssueAssignee")
  comments           Comment[]
  notifications      Notification[]
  clientProjects     ClientProject[]
  refreshTokens      RefreshToken[]
  expenses           Expense[]        @relation("ExpenseSubmitter")
  contractorServices Service[]        @relation("ContractorServices")
  serviceRequests    ServiceRequest[] @relation("ClientRequests")
  sentMessages       Message[]        @relation("MessageSender")

  /// Marketplace (quotes / jobs)
  postedJobs         MarketplaceJob[] @relation("JobClient")
  jobInvitations     JobInvitation[]  @relation("InvitationTrader")
  quotes             Quote[]          @relation("QuoteTrader")
  feeLedgerEntries   FeeLedger[]      @relation("FeeTrader")
  payouts            Payout[]         @relation("PayoutTrader")
  disputesRaised     Dispute[]        @relation("DisputeRaiser")

  /// Stripe Connect (traders)
  stripeAccountId       String?
  stripeCustomerId      String?
  stripeOnboardingDone  Boolean @default(false)
  stripePayoutsEnabled  Boolean @default(false)
  feePaymentMethodId    String?

  @@map("users")
}

// Admin-managed staff roles (Manager, Employee, etc.)
model StaffRole {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  key         String   @unique
  description String?
  /// Maps to system UserRole for dashboard access / hierarchy
  baseRole    UserRole
  permissions String[]
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("staff_roles")
}

// ============================================================
// AUTH TOKENS
// ============================================================

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  expires   DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================================
// CLIENT
// ============================================================

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String?  @unique
  phone     String?
  company   String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  pan       String?
  gst       String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  invoices Invoice[]

  @@map("clients")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  code             String        @unique
  description      String?
  type             String?
  status           ProjectStatus @default(PLANNING)
  startDate        DateTime?
  endDate          DateTime?
  estimatedEndDate DateTime?
  budgetAmount     Float         @default(0)
  spentAmount      Float         @default(0)
  contractValue    Float?
  progress         Int           @default(0)
  location         String?
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  coverImage       String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  clientId  String  @db.ObjectId
  managerId String? @db.ObjectId

  client      Client              @relation(fields: [clientId], references: [id])
  manager     User?               @relation("ProjectManager", fields: [managerId], references: [id])
  milestones  Milestone[]
  tasks       Task[]
  contractors ProjectContractor[]
  materials   ProjectMaterial[]
  directMaterials Material[]      @relation("ProjectMaterialDirect")
  equipment   ProjectEquipment[]
  documents   Document[]
  siteReports SiteReport[]
  invoices    Invoice[]
  issues      Issue[]
  expenses    Expense[]
  members     ClientProject[]

  @@map("projects")
}

model ClientProject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  userId    String   @db.ObjectId
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("client_projects")
}

// ============================================================
// MILESTONE & TASK
// ============================================================

model Milestone {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  title       String?
  description String?
  status      MilestoneStatus @default(PENDING)
  completed   Boolean         @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  projectId String @db.ObjectId

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("milestones")
}

model Task {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projectId   String  @db.ObjectId
  milestoneId String? @db.ObjectId
  assigneeId  String? @db.ObjectId
  creatorId   String  @db.ObjectId

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator   User       @relation("TaskCreator", fields: [creatorId], references: [id])
  comments  Comment[]

  @@map("tasks")
}

// ============================================================
// CONTRACTOR
// ============================================================

model Contractor {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  company        String?
  type           ContractorType @default(GENERAL)
  specialization String?
  email          String?        @unique
  phone          String?
  address        String?
  city           String?
  state          String?
  pan            String?
  gst            String?
  licenseNumber  String?
  rating         Float?
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  projects ProjectContractor[]
  invoices Invoice[]

  @@map("contractors")
}

model ProjectContractor {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  contractValue Float     @default(0)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  projectId    String @db.ObjectId
  contractorId String @db.ObjectId

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id])

  @@unique([projectId, contractorId])
  @@map("project_contractors")
}

// ============================================================
// MATERIAL / INVENTORY
// ============================================================

model Material {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  unit         MaterialUnit @default(PIECE)
  unitPrice    Float        @default(0)
  stockQty     Float        @default(0)
  minStockQty  Float        @default(0)
  currentStock Float?
  minimumStock Float?
  category     String?
  supplier     String?
  projectId    String?      @db.ObjectId
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project          Project?         @relation("ProjectMaterialDirect", fields: [projectId], references: [id])
  projectMaterials ProjectMaterial[]

  @@map("materials")
}

model ProjectMaterial {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  quantity     Float
  usedQuantity Float     @default(0)
  unitPrice    Float
  totalCost    Float
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projectId  String @db.ObjectId
  materialId String @db.ObjectId

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@map("project_materials")
}

// ============================================================
// EQUIPMENT
// ============================================================

model Equipment {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  type         String?
  model        String?
  serialNumber String?         @unique
  status       EquipmentStatus @default(AVAILABLE)
  dailyRate    Float           @default(0)
  purchaseCost Float?
  purchaseDate DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  projects ProjectEquipment[]

  @@map("equipment")
}

model ProjectEquipment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  startDate   DateTime?
  endDate     DateTime?
  totalCost   Float     @default(0)
  notes       String?
  createdAt   DateTime  @default(now())

  projectId   String @db.ObjectId
  equipmentId String @db.ObjectId

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@map("project_equipment")
}

// ============================================================
// DOCUMENT
// ============================================================

model Document {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      DocumentType @default(OTHER)
  fileUrl   String
  fileSize  Int?
  mimeType  String?
  version   String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projectId    String @db.ObjectId
  uploadedById String @db.ObjectId

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

// ============================================================
// SITE REPORT
// ============================================================

model SiteReport {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  reportDate       DateTime @default(now())
  weatherCondition String?
  weather          String?
  temperature      Float?
  workersPresent   Int      @default(0)
  totalWorkers     Int?
  workProgress     Int?
  summary          String?
  progress         String?
  activities       String?
  issues           String?
  materials        String?
  nextDayPlan      String?
  safetyNotes      String?
  photos           String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectId  String @db.ObjectId
  reporterId String @db.ObjectId

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id])

  @@map("site_reports")
}

// ============================================================
// INVOICE & PAYMENT
// ============================================================

model Invoice {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo     String        @unique
  invoiceNumber String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidDate      DateTime?
  subtotal      Float         @default(0)
  taxRate       Float         @default(0)
  taxAmount     Float         @default(0)
  totalAmount   Float         @default(0)
  paidAmount    Float         @default(0)
  terms         String?
  notes         String?
  createdById   String?       @db.ObjectId
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projectId    String  @db.ObjectId
  clientId     String? @db.ObjectId
  contractorId String? @db.ObjectId

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  payments   Payment[]
  lineItems  InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  totalPrice  Float
  order       Int    @default(0)

  invoiceId String @db.ObjectId

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  method        PaymentMethod @default(BANK_TRANSFER)
  transactionId String?
  paymentDate   DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())

  invoiceId String @db.ObjectId

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ============================================================
// EXPENSE
// ============================================================

model Expense {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  category       String
  amount         Float
  expenseDate    DateTime @default(now())
  description    String?
  receipt        String?
  vendor         String?
  submittedById  String?  @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId String? @db.ObjectId

  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy   User?    @relation("ExpenseSubmitter", fields: [submittedById], references: [id])

  @@map("expenses")
}

// ============================================================
// ISSUE
// ============================================================

model Issue {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  severity    IssueSeverity @default(MEDIUM)
  location    String?
  photos      String[]
  resolvedAt  DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId  String  @db.ObjectId
  reporterId String  @db.ObjectId
  assigneeId String? @db.ObjectId

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User     @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee User?    @relation("IssueAssignee", fields: [assigneeId], references: [id])
  comments Comment[]

  @@map("issues")
}

// ============================================================
// COMMENT
// ============================================================

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String  @db.ObjectId
  taskId   String? @db.ObjectId
  issueId  String? @db.ObjectId

  author User   @relation(fields: [authorId], references: [id])
  task   Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issue  Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// SERVICES (Contractor offers → Customer requests)
// ============================================================

model Service {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  category     String
  priceFrom    Float?
  priceTo      Float?
  priceUnit    String?
  isActive     Boolean  @default(true)
  contractorId String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contractor User             @relation("ContractorServices", fields: [contractorId], references: [id])
  requests   ServiceRequest[]

  @@map("services")
}

model ServiceRequest {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  message   String?
  location  String?
  budget    Float?
  status    ServiceRequestStatus @default(PENDING)
  serviceId String               @db.ObjectId
  clientId  String               @db.ObjectId
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  service  Service   @relation(fields: [serviceId], references: [id])
  client   User      @relation("ClientRequests", fields: [clientId], references: [id])
  messages Message[]

  @@map("service_requests")
}

model Message {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  body             String   @default("")
  attachmentUrl    String?
  attachmentName   String?
  attachmentMime   String?
  attachmentSize   Int?
  serviceRequestId String   @db.ObjectId
  senderId         String   @db.ObjectId
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  sender         User           @relation("MessageSender", fields: [senderId], references: [id])

  @@index([serviceRequestId])
  @@map("messages")
}

// ============================================================
// EMAIL / SMTP (admin-managed)
// ============================================================

model SmtpSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String
  password  String
  fromEmail String
  fromName  String?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("smtp_settings")
}

model EmailTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  name        String
  subject     String
  bodyHtml    String
  description String?
  variables   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

// ============================================================
// MARKETPLACE: Pricing, Quotes, Payment Protection
// ============================================================

enum TraderFeeType {
  PERCENTAGE
  FIXED
}

enum ProtectionDefaultMode {
  OPT_IN
  OPT_OUT
}

enum UnprotectedReleaseTiming {
  JOB_START
  COMPLETION
}

enum MarketplaceJobStatus {
  OPEN
  QUOTES_RECEIVED
  AWAITING_PAYMENT
  FUNDED
  IN_PROGRESS
  COMPLETED
  PAID_OUT
  EXPIRED
  CANCELLED
  DISPUTED
  RESOLVED
}

enum ProtectionStatus {
  PROTECTED
  UNPROTECTED
  UNDECIDED
}

enum InvitationStatus {
  SENT
  VIEWED
  QUOTED
  DECLINED
  EXPIRED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  NOT_SELECTED
  WITHDRAWN
  EXPIRED
}

enum MarketplacePaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FeeLedgerStatus {
  PENDING
  COLLECTED
  VOIDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  FULL_RELEASE
  PARTIAL_RELEASE
  REFUNDED
  CLOSED
}

/// Singleton-style admin-editable rates (key = "default")
model PricingConfig {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  key                    String                   @unique @default("default")
  traderFeeType          TraderFeeType            @default(PERCENTAGE)
  traderFeeRate          Float                    @default(0.10)
  traderFeeCap           Float?
  protectionFeeEnabled   Boolean                  @default(true)
  protectionFeeRate      Float                    @default(0.03)
  protectionFeeDefault   ProtectionDefaultMode    @default(OPT_IN)
  unprotectedReleaseAt   UnprotectedReleaseTiming @default(JOB_START)
  quoteValidDays         Int                      @default(14)
  invitationExpiryHours  Int                      @default(48)
  autoConfirmDays        Int                      @default(5)
  matchingInviteCount    Int                      @default(3)
  maxReassignments       Int                      @default(6)
  /// Per-category overrides: { "Plumbing": { traderFeeRate: 0.08, traderFeeCap: 5000 } }
  categoryOverrides      Json?
  termsVersion           String                   @default("v1.0")
  updatedById            String?                  @db.ObjectId
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@map("pricing_config")
}

model MarketplaceJob {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  category         String
  location         String?
  photos           String[]
  budgetMin        Float?
  budgetMax        Float?
  status           MarketplaceJobStatus @default(OPEN)
  protectionStatus ProtectionStatus     @default(UNDECIDED)
  startDate        DateTime?
  completedAt      DateTime?
  confirmedAt      DateTime?
  clientId         String               @db.ObjectId
  acceptedQuoteId  String?              @db.ObjectId
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  client      User            @relation("JobClient", fields: [clientId], references: [id])
  invitations JobInvitation[]
  quotes      Quote[]
  payments    MarketplacePayment[]
  payouts     Payout[]
  disputes    Dispute[]

  @@index([clientId, status])
  @@index([category, status])
  @@map("marketplace_jobs")
}

model JobInvitation {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String           @db.ObjectId
  traderId  String           @db.ObjectId
  status    InvitationStatus @default(SENT)
  rank      Int              @default(1)
  sentAt    DateTime         @default(now())
  expiresAt DateTime
  viewedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  job    MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trader User           @relation("InvitationTrader", fields: [traderId], references: [id])

  @@index([jobId, status])
  @@index([traderId, status])
  @@map("job_invitations")
}

model Quote {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String      @db.ObjectId
  traderId    String      @db.ObjectId
  amount      Float
  scope       String?
  startDate   DateTime?
  validUntil  DateTime
  status      QuoteStatus @default(SUBMITTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  job      MarketplaceJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trader   User                   @relation("QuoteTrader", fields: [traderId], references: [id])
  payments MarketplacePayment[]
  feeLedger FeeLedger?

  @@index([jobId, status])
  @@index([traderId, status])
  @@map("quotes")
}

model MarketplacePayment {
  id                    String                   @id @default(auto()) @map("_id") @db.ObjectId
  jobId                 String                   @db.ObjectId
  quoteId               String                   @db.ObjectId
  customerTotal         Float
  protectionOptedIn     Boolean                  @default(false)
  protectionFee         Float                    @default(0)
  quoteAmount           Float
  termsVersion          String
  stripePaymentIntentId String?
  status                MarketplacePaymentStatus @default(PENDING)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  job   MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  quote Quote          @relation(fields: [quoteId], references: [id])

  @@index([jobId])
  @@index([stripePaymentIntentId])
  @@map("marketplace_payments")
}

model FeeLedger {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  quoteId   String          @unique @db.ObjectId
  traderId  String          @db.ObjectId
  amount    Float
  status    FeeLedgerStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  quote  Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  trader User  @relation("FeeTrader", fields: [traderId], references: [id])

  @@index([traderId, status])
  @@map("fee_ledger")
}

model Payout {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  traderId        String   @db.ObjectId
  jobId           String   @db.ObjectId
  netAmount       Float
  stripeTransferId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trader User           @relation("PayoutTrader", fields: [traderId], references: [id])
  job    MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([jobId])
  @@map("payouts")
}

model Dispute {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  jobId      String        @db.ObjectId
  raisedById String        @db.ObjectId
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  job      MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  raisedBy User           @relation("DisputeRaiser", fields: [raisedById], references: [id])

  @@index([jobId, status])
  @@map("disputes")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  entity    String
  entityId  String
  action    String
  actorId   String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
